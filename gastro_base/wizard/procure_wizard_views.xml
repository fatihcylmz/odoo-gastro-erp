<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gastro_procure_wizard_form" model="ir.ui.view">
        <field name="name">gastro.procure.wizard.form</field>
        <field name="model">gastro.procure.wizard</field>
        <field name="arch" type="xml">
            <form string="Tedarik Et">
                <group>
                    <field name="product_id"/>
                    <field name="available_stock"/>
                    <field name="procure_qty"/>
                </group>
                <footer>
                    <button name="action_confirm_procurement" type="object" string="Onayla ve Depoya Çek" class="btn-primary"/>
                    <button special="cancel" string="İptal" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>