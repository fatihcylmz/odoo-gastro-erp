<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mutfak Deposu (Yerel Envanter) Liste Görünümü -->
    <record id="view_gastro_local_inventory_list" model="ir.ui.view">
        <field name="name">gastro.local.inventory.list</field>
        <field name="model">gastro.local.inventory</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="qty_in_stock"/>
                
                <!-- LİSTEYE EKLENMESİ GEREKEN ALANLAR BURADA -->
                <field name="stock_status" widget="badge" decoration-success="stock_status == 'var'" decoration-warning="stock_status == 'kritik'" decoration-danger="stock_status == 'yok'"/>
                <field name="discount_rate" string="İndirim (%)"/>
                
                <field name="purchase_price" widget="monetary"/>
                <field name="expiration_date"/>
            </list>
        </field>
    </record>

    <!-- Mutfak Deposu Form Görünümü -->
    <record id="view_gastro_local_inventory_form" model="ir.ui.view">
        <field name="name">gastro.local.inventory.form</field>
        <field name="model">gastro.local.inventory</field>
        <field name="arch" type="xml">
            <form string="Mutfak Deposu">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="supplier_product_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="qty_in_stock"/>
                            <!-- Stok durumunu renklendirilmiş rozet olarak gösterir -->
                            <field name="stock_status" widget="badge" decoration-success="stock_status == 'var'" decoration-warning="stock_status == 'kritik'" decoration-danger="stock_status == 'yok'"/>
                            <!-- İndirim oranını listeye ekler -->
                            <field name="discount_rate"/>
                            <field name="purchase_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Aksiyon ve Menü Tanımlaması -->
    <record id="action_gastro_local_inventory" model="ir.actions.act_window">
        <field name="name">Mutfak Deposu</field>
        <field name="res_model">gastro.local.inventory</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Mevcut gastro_base menüsünün altına Mutfak Deposunu ekliyoruz -->
    <menuitem id="menu_gastro_local_inventory" 
              name="Mutfak Deposu" 
              parent="menu_gastro_root" 
              action="action_gastro_local_inventory" 
              sequence="20"
              groups="gastro_base.group_gastro_admin,gastro_base.group_gastro_user"/>
</odoo>